<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    tools:context=".EventosFragment">

    <ImageView
        android:id="@+id/logo_eventos"
        android:layout_width="350dp"
        android:layout_height="140dp"
        android:layout_marginTop="32dp"
        android:contentDescription="@string/menu_eventos"
        android:scaleType="fitCenter"
        android:src="@drawable/eventos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.491"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/violetas"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop="156dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/violetas"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/texto_eventos"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:text="@string/texto_eventos"
        android:textSize="23sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/violetas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/filtro_botones_pelis_expos"
        android:layout_width="245dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/texto_eventos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@id/boton_expos"
        >
        <com.google.android.material.button.MaterialButton
            style="?attr/materialButtonOutlinedStyle"
            android:id="@+id/boton_expos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filtro_expos" />

        <com.google.android.material.button.MaterialButton
            style="?attr/materialButtonOutlinedStyle"
            android:id="@+id/boton_pelis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filtro_pelis" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <ListView
        android:id="@+id/lista_eventos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/filtro_botones_pelis_expos"
        android:scrollbars="none"/>

</androidx.constraintlayout.widget.ConstraintLayout>