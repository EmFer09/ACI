url= "https://www.cinetecamadrid.com/programacion?to=today"

#Esta página daba error 403 al hacer la petición, por lo que se añade un header para que la petición se haga como si fuera un navegador web
headers = {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/58.0.3029.110 Safari/537.3"
}

#y se hace la petición con el header dentro de un bucle if else por si falla
response = requests.get(url, headers=headers)
if response.status_code == 200:
    soup = BeautifulSoup(response.content, "html.parser")
else:
    print(f"Error al acceder a la página: {response.status_code}")

#tras encontrar mediante pruebas de qué elemento sale el link que interesa se obtiene mediante una cadena de variables, "desenredando" los elementos que lo contienen hasta llegar a la dirección
links = soup.find('div', class_="messages--notification")
enlace = links.find('a')
descarga_pdf = enlace.get('href')
#como el enlace que obtenemos es una ruta relativa, el método get da error porque falta el servidor, para solucionarlo se usa urljoin
enlace_bueno = urljoin(url, descarga_pdf)

#una vez localizado el link de descarga, se inicia la descarga mediante requests usando los headers de nuevo para evitar otro error
response_pdf = requests.get(enlace_bueno, headers= headers)

if response_pdf.status_code == 200:
    with open("PROGRAMA-CALENDARIO_NOV26_CINETECA.pdf", "wb") as f:
        f.write(response_pdf.content)
else:
    print("Error")

